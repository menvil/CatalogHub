{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26 <27"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "node tools/ci/lint-javascript.mjs",
        "test:frontend": "node --test tests/Frontend/*.test.mjs",
        "test:browser": "CATALOGHUB_BROWSER_PORT=8014 playwright test --config=playwright.config.mjs --project=browser",
        "test:browser:install": "playwright install chromium",
        "test:visual": "CATALOGHUB_BROWSER_PORT=8015 playwright test --config=playwright.config.mjs --project=visual",
        "test:visual:update": "CATALOGHUB_BROWSER_PORT=8015 playwright test --config=playwright.config.mjs --project=visual --update-snapshots"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^10.0.4",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.2.0"
    }
}
